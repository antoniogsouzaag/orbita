{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "buildCommand": "node scripts/migrate.mjs && next build",
  "crons": [
    {
      "path": "/api/cron/brief",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/orbe",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/midia",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/redes",
      "schedule": "15 3 * * *"
    }
  ]
}
