# ── Obrigatórias em produção ─────────────────────────────
# Senha de acesso (único dono). Prefira o hash: node scripts/hash-password.mjs
ORBITA_PASSWORD_HASH=
ORBITA_PASSWORD=
# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=
# Postgres. Neon (recomendado na Vercel) ou qualquer Postgres. Sem ela, usa PGlite local em .data/
DATABASE_URL=

# ── Preferências ─────────────────────────────────────────
OWNER_NAME=Antonio Garcia
APP_TIMEZONE=America/Sao_Paulo

# ── Vault (Obsidian) ─────────────────────────────────────
# Produção: token fine-grained do GitHub com "Contents: Read and write" só no repositório do vault
VAULT_GITHUB_TOKEN=
VAULT_GITHUB_REPO=aglabs-core/ag-labs-knowledge
VAULT_GITHUB_BRANCH=main
# Desenvolvimento/VPS: caminho de uma cópia local do vault (tem prioridade sobre o GitHub)
VAULT_LOCAL_PATH=

# ── IA ───────────────────────────────────────────────────
# OpenAI (padrão). Modelo padrão: gpt-6-luna
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Alternativa: Claude (use AI_PROVIDER=anthropic para forçar)
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Operação ─────────────────────────────────────────────
# n8n: JSON com as instâncias e chaves da API pública (Settings → n8n API)
# N8N_INSTANCES=[{"name":"VPS-01","url":"https://n8na.aglabs.api.br","apiKey":"..."},{"name":"VPS-03","url":"https://n8nb.aglabs.api.br","apiKey":"..."}]
N8N_INSTANCES=
# Token dos monitores do n8n (/api/ops/alvos e /api/ops/ingest) — mínimo 16 caracteres
OPS_TOKEN=
# Token para agentes lerem o contexto operacional em /api/context
CONTEXT_TOKEN=
# CRM (servidor MCP do crm-dash, docs/mcp.md lá): endereço e token da Órbita
CRM_MCP_URL=
CRM_MCP_TOKEN=
# PRs e propostas da organização (fine-grained, leitura de Pull requests, Issues e Metadata).
# Precedência: GITHUB_INBOX_TOKEN > GITHUB_TOKEN > VAULT_GITHUB_TOKEN.
# O token do Knowledge é reaproveitado só com suas permissões atuais: se restrito ao vault,
# não oferece visão dos outros repositórios privados. Prefira token separado de leitura para a visão geral.
GITHUB_INBOX_TOKEN=
GITHUB_ORG=aglabs-core

# ── Telegram ─────────────────────────────────────────────
# Bom dia às 7h e aviso de pedido de agente
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Autoriza o agendador da Vercel em /api/cron/brief
CRON_SECRET=

# ── Agenda ───────────────────────────────────────────────
# Token do feed ICS (assine no iPhone: /api/calendar/feed.ics?token=...)
CALENDAR_FEED_TOKEN=

# ── Opcionais ────────────────────────────────────────────
# Busca de capas no Unsplash (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=
# Sequência de commits no herói do Início
GITHUB_USER=antoniogsouzaag
GITHUB_TOKEN=
