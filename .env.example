# ── Obrigatórias em produção ─────────────────────────────
# Senha de acesso (único dono)
ORBITA_PASSWORD=
# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=
# Postgres. Neon (recomendado na Vercel) ou qualquer Postgres. Sem ela, usa PGlite local em .data/
DATABASE_URL=

# ── Preferências ─────────────────────────────────────────
OWNER_NAME=Antonio Garcia
APP_TIMEZONE=America/Sao_Paulo

# ── Vault (Obsidian) ─────────────────────────────────────
# Produção: token fine-grained do GitHub com "Contents: Read and write" só no repositório do vault
VAULT_GITHUB_TOKEN=
VAULT_GITHUB_REPO=aglabs-core/ag-labs-knowledge
VAULT_GITHUB_BRANCH=main
# Desenvolvimento/VPS: caminho de uma cópia local do vault (tem prioridade sobre o GitHub)
VAULT_LOCAL_PATH=

# ── IA (Claude) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Operação ─────────────────────────────────────────────
# n8n: JSON com as instâncias e chaves da API pública (Settings → n8n API)
# N8N_INSTANCES=[{"name":"VPS-01","url":"https://n8na.aglabs.api.br","apiKey":"..."},{"name":"VPS-03","url":"https://n8nb.aglabs.api.br","apiKey":"..."}]
N8N_INSTANCES=
# Token para agentes lerem o contexto operacional em /api/context
CONTEXT_TOKEN=

# ── Agenda ───────────────────────────────────────────────
# Token do feed ICS (assine no iPhone: /api/calendar/feed.ics?token=...)
CALENDAR_FEED_TOKEN=

# ── Opcionais ────────────────────────────────────────────
# Busca de capas no Unsplash (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=
# Sequência de commits no herói do Início
GITHUB_USER=antoniogsouzaag
GITHUB_TOKEN=
